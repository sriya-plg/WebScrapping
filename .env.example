# Optional override for backend.base_url in config/app.yaml.
TRACKER_BASE_URL=https://plgtst.pegasuslogistics.com
# Optional API bearer token. Leave unset when the backend does not require auth.
TRACKER_API_TOKEN=

# Secure key for decrypting carrier passwords (Fernet 32-byte url-safe base64 key).
# Required when backend carrier configuration passwords are encrypted.
CARRIER_CREDENTIALS_KEY=
# Optional credential resolver type ("fernet" or "identity"; defaults to fernet when key is configured).
CREDENTIAL_RESOLVER=
