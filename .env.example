# Backend API
TRACKER_BASE_URL=https://plgtst.pegasuslogistics.com
TRACKER_API_TOKEN=
CARRIER_CONFIG_METHOD=GET
# Optional overrides; defaults match the current backend contract.
# CARRIER_CONFIG_PATH=/api/orderentry/GetCarrierConfigurationDetails
# SHIPMENTS_PATH=/api/orderentry/GetCarrierShipmentDetails
# CARRIER_ACTIVITY_PATH=/api/orderentry/AddCarrierActivity
BACKEND_TIMEOUT_SECONDS=30
BACKEND_RETRY_ATTEMPTS=3

# Set these only when the backend uses Fernet-encrypted carrier credentials.
CREDENTIAL_RESOLVER=
CARRIER_CREDENTIALS_KEY=

# Runtime
RUN_INTERVAL_HOURS=3
# RUN_TIMEOUT_HOURS=2
BROWSER_HEADLESS=true
LOG_LEVEL=INFO
LOG_FORMAT=console
# LOGS_DIR=app/runtime/logs
# BROWSER_STATE_DIR=app/runtime/browser
# SCRAPER_DEBUG_DIR=app/runtime/debug
# ALERT_WEBHOOK_URL=
